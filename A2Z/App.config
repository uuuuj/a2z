<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

    <!--
      도면에 들어가는 값이 모델의 어느 속성에서 오는지 여기서 정한다.
      속성 이름이 바뀌어도 프로그램을 다시 만들 필요 없이, 이 파일만 고치고 다시 켜면 된다.
      값을 비워두면 그 칸을 채우지 않는다 — 빈칸으로 나가고 표의 괘선은 그대로 남는다.
    -->
    <appSettings>
        <!--
          표제부 TAG NO. 칸에 넣을 속성 이름.

          지금 비어 있는 이유: 여기 들어가야 하는 값은 생산설계 모델 이름인데
          그 속성 이름을 아직 받지 못했다. 예전에 쓰던 STRU는 상세설계 이름이라
          틀린 값이고, 틀린 번호가 도면에 찍히는 것보다 빈칸이 안전하다.
          속성 이름을 받으면 아래 따옴표 사이에 그 이름만 적으면 된다.
        -->
        <add key="Uda.TagNo" value="" />

        <!--
          표제부 DP No. 칸에 넣을 속성 이름. STRU 단위로 붙어 있다.
          (2026-08-05 담당자 확인)
        -->
        <add key="Uda.DpNo" value=":SHI_DSN_DP" />

        <!--
          BOM 표의 MA · FA 열에 넣을 속성 이름. 부재 단위로 붙어 있다.
          (2026-08-05 담당자 확인)

          값이 없는 부재는 그 칸을 "-"로 표시한다. 예전에는 아무 근거 없이
          MA=L · FA=F를 넣고 있었는데, 없는 값을 지어내는 것보다 없다고 보이는 편이 낫다.
        -->
        <add key="Uda.BomMa" value=":SHI_MA" />
        <add key="Uda.BomFa" value=":SHI_FA" />

        <!--
          모델을 열 때, 부재와 그 위쪽 노드에 붙어 있는 속성을 전부 로그로 남긴다.
          어떤 속성에 어떤 값이 들어 있는지 눈으로 찾을 때만 true로 바꾼다.
          평소에는 false — 켜두면 모델 열 때마다 몇 초씩 느려진다.
          로그는 실행 파일 폴더의 logs 안에 날짜별로 쌓인다.
        -->
        <add key="Uda.DumpOnLoad" value="false" />

        <!--
          도면 여러 장을 PDF 한 파일로 묶을지 정한다.

          false = 도면 한 장마다 파일 하나 (기본). 한 장 만들어 저장하고 화면을 비운 뒤
                  다음 장을 만든다. 이름이 겹치면 뒤에 _1, _2 가 붙는다.
          true  = 그 종류의 도면 전부를 한 파일에 담는다.

          기본이 false인 이유: 한 파일로 묶으려면 저장할 때까지 모든 장의 도면 내용이
          화면에 함께 올라가 있어야 한다. 조립도처럼 장수가 많으면 이것 때문에
          "보호된 메모리" 오류가 나면서 프로그램이 그대로 꺼진다 (2026-08-04 확인).

          도면 프로그램이 제공하는 저장 기능은 화면에 올라온 것을 한 번에 내보낼 뿐,
          이미 만들어 둔 PDF에 뒤이어 붙이지는 못한다. 그래서 "장마다 비우기"와
          "한 파일로 묶기"를 지금은 동시에 할 수 없다.
        -->
        <add key="Pdf.MergePages" value="false" />
    </appSettings>
</configuration>