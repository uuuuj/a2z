    <!-- 제작도 고정 이미지: 실행 폴더 기준 절대경로로 사용할 수 있도록 자동 복사 -->
    <Content Include="..\assets\North_Arrow.png">
      <Link>North_Arrow.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\assets\ISO_North_Arrow.png">
      <Link>ISO_North_Arrow.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 회사 로고: 저작권 문제로 레포에서 제외 (2026-08-21). lib\ 대용량 DLL과 같이 각 PC가 로컬에 둔다. -->
    <!-- Condition 없이 두면 파일이 없는 PC에서 MSB3030으로 빌드가 통째로 깨진다. -->
    <!-- 없으면 복사를 건너뛰고, 코드(AddImageSlotIfExists)가 해당 도면 칸을 빈 채로 남긴다. -->
    <Content Include="..\assets\Logo.png" Condition="Exists('..\assets\Logo.png')">
      <Link>Logo.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\assets\ClientTestImage.png">
      <Link>ClientTestImage.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 도면 엑셀 템플릿: 실행 폴더 templates\로 복사 (.sln 없는 배포 패키지 대응 — #71). -->
    <!-- Link 경로는 Form1.DrawingSheets.cs의 TemplateOutputFolderName과 일치해야 한다. -->
    <!-- 템플릿 수정은 레포 루트 원본을 고치고 재빌드 — 실행 폴더 사본은 다음 빌드에 덮어써진다. -->
    <Content Include="..\제작도_도면.xlsx">
      <Link>templates\제작도_도면.xlsx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\가공도_도면.xlsx">
      <Link>templates\가공도_도면.xlsx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- VizCore 네이티브/보조 DLL: lib\에서 빌드 출력 폴더로 복사 (런타임 동적 로드). -->
    <!-- Reference(관리 API)와 달리 이들은 컴파일 참조가 아니라 실행 시 필요. -->
    <!-- 소스는 프로젝트 내 ..\lib\ (bin\Debug 의존 제거, 클린 빌드 가능). VizCore 1.0.26.723. -->
    <!-- Content여야 하는 이유 (#200): ClickOnce 게시 매니페스트에는 Content와 참조 어셈블리만 -->
    <!-- 담기고 None은 제외된다. None이던 시절엔 설치는 정상 완료되고 실행하는 순간 네이티브 -->
    <!-- 엔진이 없어 오류 없이 죽었다. 일반 빌드 동작은 CopyToOutputDirectory가 그대로 담당한다. -->
    <Content Include="..\lib\VIZCore3D.NET.Interop.dll">
      <Link>VIZCore3D.NET.Interop.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\lib\ShdCore.dll">
